// ==================== REPORTS ====================
const REPORT_MONTH_COLORS = {
    'জানুয়ারি': { bg: '#e74c3c', grad1: '#c0392b', grad2: '#e74c3c' },
    'ফেব্রুয়ারি': { bg: '#9b59b6', grad1: '#8e44ad', grad2: '#9b59b6' },
    'মার্চ': { bg: '#2ecc71', grad1: '#27ae60', grad2: '#2ecc71' },
    'এপ্রিল': { bg: '#3498db', grad1: '#2980b9', grad2: '#3498db' },
    'মে': { bg: '#f39c12', grad1: '#e67e22', grad2: '#f39c12' },
    'জুন': { bg: '#1abc9c', grad1: '#16a085', grad2: '#1abc9c' },
    'জুলাই': { bg: '#e74c3c', grad1: '#c0392b', grad2: '#e74c3c' },
    'আগস্ট': { bg: '#8e44ad', grad1: '#7d3c98', grad2: '#8e44ad' },
    'সেপ্টেম্বর': { bg: '#2c3e50', grad1: '#1a252f', grad2: '#2c3e50' },
    'অক্টোবর': { bg: '#d35400', grad1: '#ba4a00', grad2: '#d35400' },
    'নভেম্বর': { bg: '#2980b9', grad1: '#1a5276', grad2: '#2980b9' },
    'ডিসেম্বর': { bg: '#27ae60', grad1: '#1e8449', grad2: '#27ae60' }
};

function getMonthColor(displayMonth) {
    for (const [month, colors] of Object.entries(REPORT_MONTH_COLORS)) {
        if (displayMonth.includes(month)) {
            return colors;
        }
    }
    return { bg: '#0f3460', grad1: '#1a1a2e', grad2: '#0f3460' };
}

function showReports() {
function showReports() {
    if (!APP.activeMeterId || APP.meters.length === 0) {
        showToast('প্রথমে একটি মিটার যোগ করুন', 'warning');
        navigateTo('meters');
        return;
    }

    document.getElementById('pageContent').innerHTML = `
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
                <h2>📊 রিপোর্ট</h2>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <select id="reportMeterSelect" onchange="switchReportMeter(this.value)" style="padding: 8px; border-radius: 8px; border: 1px solid var(--border);">
                        ${APP.meters.map(m => `<option value="${m.id}" ${APP.activeMeterId === m.id ? 'selected' : ''}>${m.name} - ${m.meterNumber || m.meterNo || ''}</option>`).join('')}
                    </select>
                </div>
            </div>
            <div class="tabs" style="margin-top: 15px;">
                <div class="tab active" onclick="switchReportTab('history')">📋 ট্রানজেকশন হিস্ট্রি</div>
                <div class="tab" onclick="switchReportTab('monthly')">📅 মাসিক সারাংশ</div>
                <div class="tab" onclick="switchReportTab('slab')">📊 স্ল্যাব বিশ্লেষণ</div>
            </div>
            <div id="reportContent"></div>
            <div style="margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn" onclick="exportToExcel()">📥 এক্সপোর্ট টু এক্সেল</button>
                <button class="btn" onclick="printReport()">🖨️ প্রিন্ট রিপোর্ট</button>
            </div>
        </div>
    `;
    switchReportTab('history');
}

function switchReportMeter(meterId) {
    APP.activeMeterId = meterId;
    saveData();
    
    const activeTab = document.querySelector('.tab.active');
    const tabName = activeTab ? activeTab.textContent.includes('হিস্ট্রি') ? 'history' : 
                    activeTab.textContent.includes('সারাংশ') ? 'monthly' : 'slab' : 'history';
    switchReportTab(tabName);
}

function getMonthlySlabAnalysis(meterId) {
    const meterData = APP.metersData[meterId];
    if (!meterData) return {};
    
    const transactions = meterData.transactions || [];
    const bills = transactions.filter(t => t.type === 'electricity_bill' || t.type === 'bill');
    const recharges = transactions.filter(t => t.type === 'recharge');
    
    const slabDefs = [
        { name: 'Lifeline (০-৫০)', min: 0, max: 50, rate: 3.5 },
        { name: '১ম স্ল্যাব (৫১-৭৫)', min: 51, max: 75, rate: 4 },
        { name: '২য় স্ল্যাব (৭৬-২০০)', min: 76, max: 200, rate: 5.45 },
        { name: '৩য় স্ল্যাব (২০১-৩০০)', min: 201, max: 300, rate: 5.7 },
        { name: '৪র্থ স্ল্যাব (৩০১-৪০০)', min: 301, max: 400, rate: 6.02 },
        { name: '৫ম স্ল্যাব (৪০১-৬০০)', min: 401, max: 600, rate: 9.3 },
        { name: '৬ষ্ঠ স্ল্যাব (৬০১+)', min: 601, max: Infinity, rate: 10.7 }
    ];
    
    const monthlyData = {};
    
    // First pass: aggregate total units per month from all bills
    bills.forEach(t => {
        const d = new Date(t.date || t.timestamp);
        const monthKey = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
        const banglaMonths = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];
        const displayMonth = banglaMonths[d.getMonth()] + ' ' + d.getFullYear();
        
        if (!monthlyData[monthKey]) {
            const sd = {}, sr = {}, sc = {};
            slabDefs.forEach(s => { sd[s.name] = 0; sr[s.name] = s.rate; sc[s.name] = 0; });
            monthlyData[monthKey] = {
                displayMonth: displayMonth,
                totalUnits: 0,
                totalBill: 0,
                billCount: 0,
                rechargeCount: 0,
                rechargeTotal: 0,
                slabData: sd,
                slabRates: sr,
                slabCost: sc
            };
        }
        
        monthlyData[monthKey].totalUnits += t.units || 0;
        monthlyData[monthKey].totalBill += t.amount || 0;
        monthlyData[monthKey].billCount++;
    });
    
    // Second pass: distribute total monthly units across slabs
    Object.keys(monthlyData).forEach(key => {
        const m = monthlyData[key];
        let remainingUnits = m.totalUnits;
        
        slabDefs.forEach(slab => {
            if (remainingUnits <= 0) return;
            
            let slabUnits;
            if (slab.max === Infinity) {
                slabUnits = remainingUnits;
            } else {
                const slabSize = slab.max - slab.min + 1;
                slabUnits = Math.min(remainingUnits, slabSize);
            }
            
            if (slabUnits > 0) {
                m.slabData[slab.name] = slabUnits;
                m.slabCost[slab.name] = slabUnits * slab.rate;
                remainingUnits -= slabUnits;
            }
        });
    });
    
    // Process recharges
    recharges.forEach(t => {
        const d = new Date(t.date || t.timestamp);
        const monthKey = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
        
        if (!monthlyData[monthKey]) {
            const sd = {}, sr = {}, sc = {};
            slabDefs.forEach(s => { sd[s.name] = 0; sr[s.name] = s.rate; sc[s.name] = 0; });
            const banglaMonths = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];
            monthlyData[monthKey] = {
                displayMonth: banglaMonths[d.getMonth()] + ' ' + d.getFullYear(),
                totalUnits: 0,
                totalBill: 0,
                billCount: 0,
                rechargeCount: 0,
                rechargeTotal: 0,
                slabData: sd,
                slabRates: sr,
                slabCost: sc
            };
        }
        
        monthlyData[monthKey].rechargeCount++;
        monthlyData[monthKey].rechargeTotal += t.amount || 0;
    });
    
    // Sort by date
    const sorted = {};
    Object.keys(monthlyData).sort().forEach(key => {
        sorted[key] = monthlyData[key];
    });
    
    return sorted;
}

function switchReportTab(tab) {
    // Update active tab
    const tabs = document.querySelectorAll('.tab');
    tabs.forEach(t => t.classList.remove('active'));
    
    // Find and activate the matching tab by text content
    tabs.forEach(t => {
        if ((tab === 'history' && t.textContent.includes('হিস্ট্রি')) ||
            (tab === 'monthly' && t.textContent.includes('সারাংশ')) ||
            (tab === 'slab' && t.textContent.includes('স্ল্যাব'))) {
            t.classList.add('active');
        }
    });
    
    const content = document.getElementById('reportContent');
    if (!content) return;
    
    // ✅ Safe data access
    const meterData = getActiveMeterData();
    const transactions = (meterData && meterData.transactions) ? meterData.transactions : [];
    
    if (tab === 'history') {
        const sortedTx = [...transactions].sort((a, b) => new Date(b.date || b.timestamp) - new Date(a.date || a.timestamp));
        
        content.innerHTML = `
            <div style="margin-top: 15px;">
                <h3>📋 লেনদেন ইতিহাস (${sortedTx.length}টি)</h3>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>তারিখ</th>
                                <th>ধরন</th>
                                <th>পরিমাণ</th>
                                <th>ইউনিট</th>
                                <th>বিবরণ</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${sortedTx.map(t => `
                                <tr>
                                    <td>${new Date(t.date || t.timestamp).toLocaleDateString('bn-BD')}</td>
                                    <td><span class="badge ${t.type === 'recharge' ? 'badge-success' : 'badge-warning'}">${t.type === 'recharge' ? 'রিচার্জ' : 'বিল'}</span></td>
                                    <td>৳ ${(t.amount || 0).toFixed(2)}</td>
                                    <td>${t.units ? t.units.toFixed(2) : '-'}</td>
                                    <td>${t.description || '-'}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
                ${sortedTx.length === 0 ? '<p style="text-align: center; padding: 20px; color: var(--text-light);">কোনো লেনদেন নেই</p>' : ''}
            </div>
        `;
    } else if (tab === 'monthly') {
        const banglaMonths = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];
        const vatRate = APP.settings.vatRate || 5;
        const rebateRate = APP.settings.rebateRate || 0.85;
        const demandCharge = APP.settings.demandCharge || 294;
        
        // Group recharges by month
        const monthlyRecharge = {};
        const rechargeTrans = transactions.filter(t => t.type === 'recharge');
        
        rechargeTrans.forEach(t => {
            const d = new Date(t.date || t.timestamp);
            const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
            if (!monthlyRecharge[key]) {
                monthlyRecharge[key] = { total: 0, count: 0, display: banglaMonths[d.getMonth()] + ' ' + d.getFullYear() };
            }
            monthlyRecharge[key].total += t.amount || 0;
            monthlyRecharge[key].count++;
        });
        
        // Group bills by month
        const monthlyBill = {};
        const billTrans = transactions.filter(t => t.type === 'electricity_bill' || t.type === 'bill');
        
        billTrans.forEach(t => {
            const d = new Date(t.date || t.timestamp);
            const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
            if (!monthlyBill[key]) {
                monthlyBill[key] = { total: 0, count: 0, units: 0 };
            }
            monthlyBill[key].total += t.amount || 0;
            monthlyBill[key].count++;
            monthlyBill[key].units += t.units || 0;
        });
        
        const sortedMonths = Object.keys(monthlyRecharge).sort().reverse();
        
        content.innerHTML = `
            <div style="margin-top: 15px;">
                <h3>📅 মাসিক সারাংশ</h3>
                <div style="display: grid; gap: 15px; margin-top: 15px;">
                    ${sortedMonths.map(key => {
                        const rc = monthlyRecharge[key];
                        const bl = monthlyBill[key] || { total: 0, count: 0, units: 0 };
                        const rechargeAmount = rc.total;
                        const hasRecharge = rechargeAmount > 0;
                        const usableAmount = hasRecharge ? Math.max(0, rechargeAmount - demandCharge) : 0;
                        const vat = hasRecharge ? usableAmount * (vatRate / 100) : 0;
                        const rebate = hasRecharge ? usableAmount * (rebateRate / 100) : 0;
                        
                        return `
                            <div class="card" style="background: linear-gradient(135deg, #1a1a2e, #16213e); color: white; border-left: 4px solid #e94560;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                                    <h4 style="margin:0; font-size: 18px;">📅 ${rc.display}</h4>
                                    <span style="font-size: 12px; opacity: 0.8;">🔢 রিচার্জ সংখ্যা: ${rc.count}টি</span>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                    <div>
                                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px;">
                                            <div style="font-size: 12px; opacity: 0.7;">💰 মোট রিচার্জ</div>
                                            <div style="font-size: 24px; font-weight: bold;">৳ ${rechargeAmount.toFixed(2)}</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px;">
                                            <div style="font-size: 12px; opacity: 0.7;">📊 ব্যবহারযোগ্য</div>
                                            <div style="font-size: 24px; font-weight: bold;">৳ ${usableAmount.toFixed(2)}</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px;">
                                            <div style="font-size: 12px; opacity: 0.7;">⚡ ডিমান্ড চার্জ</div>
                                            <div style="font-size: 20px; font-weight: bold; color: #ff6b6b;">৳ ${hasRecharge ? demandCharge.toFixed(2) : '০.০০'}</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px;">
                                            <div style="font-size: 12px; opacity: 0.7;">🧾 ভ্যাট (${vatRate}%)</div>
                                            <div style="font-size: 20px; font-weight: bold; color: #ffd93d;">৳ ${vat.toFixed(2)}</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px;">
                                            <div style="font-size: 12px; opacity: 0.7;">💰 রিবেট (${rebateRate}%)</div>
                                            <div style="font-size: 20px; font-weight: bold; color: #6bcb77;">৳ ${rebate.toFixed(2)}</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px;">
                                            <div style="font-size: 12px; opacity: 0.7;">📊 মোট বিল</div>
                                            <div style="font-size: 20px; font-weight: bold; color: #4d96ff;">৳ ${(bl.total || 0).toFixed(2)}</div>
                                        </div>
                                    </div>
                                </div>
                                <div style="margin-top: 10px; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px;">
                                    <div style="font-size: 12px; opacity: 0.8;">📌 ${bl.count}টি বিল | 💰 ${rc.count}টি রিচার্জ</div>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
                ${sortedMonths.length === 0 ? '<p style="text-align: center; padding: 20px; color: var(--text-light);">কোনো মাসিক ডাটা নেই</p>' : ''}
            </div>
        `;
    } else if (tab === 'slab') {
        const analysis = getMonthlySlabAnalysis(APP.activeMeterId);
        const sortedMonths = Object.keys(analysis).sort().reverse();
        
        // Calculate overall totals
        let totalUnits = 0, totalCost = 0;
        sortedMonths.forEach(key => {
            totalUnits += analysis[key].totalUnits;
            totalCost += analysis[key].totalBill;
        });
        
        const colors = ['#4CAF50', '#8BC34A', '#FFC107', '#FF9800', '#FF5722', '#f44336', '#9C27B0'];
        
        content.innerHTML = `
            <div style="margin-top: 15px;">
                <h3>📊 পূর্ববর্তী মাসের স্ল্যাব বিশ্লেষণ</h3>
                
                <div style="display: grid; gap: 20px;">
                    ${sortedMonths.map(key => {
                        const m = analysis[key];
                        const avgRate = m.totalUnits > 0 ? (m.totalBill / m.totalUnits) : 0;
                        const activeSlabs = Object.keys(m.slabData).filter(k => m.slabData[k] > 0);
                        
                        return `
                            <div class="card" style="background: #fff; border: 1px solid #e0e0e0; overflow: hidden;">
                                <div style="background: linear-gradient(135deg, #0f3460, #1a1a2e); color: white; padding: 20px; margin: -20px -20px 0 -20px;">
                                    <h4 style="margin:0 0 15px 0;">📅 ${m.displayMonth}</h4>
                                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; text-align: center;">
                                        <div>
                                            <div style="font-size: 12px; opacity: 0.7;">মাসিক ইউনিট</div>
                                            <div style="font-size: 24px; font-weight: bold;">${m.totalUnits.toFixed(2)}</div>
                                        </div>
                                        <div>
                                            <div style="font-size: 12px; opacity: 0.7;">মাসিক খরচ</div>
                                            <div style="font-size: 24px; font-weight: bold;">৳ ${m.totalBill.toFixed(2)}</div>
                                        </div>
                                        <div>
                                            <div style="font-size: 12px; opacity: 0.7;">গড়/ইউনিট</div>
                                            <div style="font-size: 24px; font-weight: bold;">৳ ${avgRate.toFixed(2)}</div>
                                        </div>
                                    </div>
                                    <div style="margin-top: 10px; font-size: 13px; opacity: 0.9; text-align: center;">
                                        📌 ${m.billCount}টি বিল | 💰 ${m.rechargeCount}টি রিচার্জ
                                    </div>
                                </div>
                                
                                <div style="margin-top: 15px;">
                                    <h5 style="margin-bottom: 10px; color: #555;">${m.displayMonth} মাসের স্ল্যাব ভিত্তিক খরচ:</h5>
                                    ${activeSlabs.map((slabKey, idx) => {
                                        const units = m.slabData[slabKey];
                                        const rate = m.slabRates[slabKey];
                                        const cost = m.slabCost[slabKey];
                                        const ci = idx % colors.length;
                                        
                                        return `
                                            <div style="margin-bottom: 6px; padding: 8px 12px; background: #f8f9fa; border-radius: 6px; border-left: 4px solid ${colors[ci]}; font-size: 14px;">
                                                <strong>${slabKey}</strong>
                                                <span style="float: right;">
                                                    ${units.toFixed(2)} kWh × ${rate} টাকা = <strong style="color: ${colors[ci]};">৳ ${cost.toFixed(2)} টাকা</strong>
                                                </span>
                                            </div>
                                        `;
                                    }).join('')}
                                    ${activeSlabs.length === 0 ? '<p style="color: var(--text-light); padding: 10px;">কোনো স্ল্যাব ডাটা নেই</p>' : ''}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
                ${sortedMonths.length === 0 ? '<p style="text-align: center; padding: 40px; color: var(--text-light);">কোনো স্ল্যাব ডাটা নেই</p>' : ''}
                
                <!-- Overall Statistics -->
                <div class="card" style="background: linear-gradient(135deg, #667eea, #764ba2); color: white; margin-top: 25px;">
                    <h4 style="margin:0 0 15px 0;">📊 পূর্ববর্তী মাসের সামগ্রিক পরিসংখ্যান</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 15px; text-align: center;">
                        <div>
                            <div style="font-size: 13px; opacity: 0.8;">মোট মাস</div>
                            <div style="font-size: 32px; font-weight: bold;">${sortedMonths.length}</div>
                        </div>
                        <div>
                            <div style="font-size: 13px; opacity: 0.8;">মোট ইউনিট</div>
                            <div style="font-size: 32px; font-weight: bold;">${totalUnits.toFixed(2)}</div>
                        </div>
                        <div>
                            <div style="font-size: 13px; opacity: 0.8;">মোট খরচ</div>
                            <div style="font-size: 32px; font-weight: bold;">৳ ${totalCost.toFixed(2)}</div>
                        </div>
                        <div>
                            <div style="font-size: 13px; opacity: 0.8;">গড় খরচ/মাস</div>
                            <div style="font-size: 24px; font-weight: bold;">৳ ${sortedMonths.length > 0 ? (totalCost / sortedMonths.length).toFixed(2) : '0.00'}</div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }
}

function exportToExcel() {
    const meterData = getActiveMeterData();
    const transactions = meterData.transactions || [];
    const meter = APP.meters.find(m => m.id === APP.activeMeterId);

    const data = transactions.map(t => ({
        'তারিখ': new Date(t.date || t.timestamp).toLocaleDateString('bn-BD'),
        'ধরন': t.type === 'recharge' ? 'রিচার্জ' : 'বিল',
        'পরিমাণ (টাকা)': t.amount || 0,
        'ইউনিট': t.units || 0,
        'বিবরণ': t.description || ''
    }));
    
    const ws = XLSX.utils.json_to_sheet(data);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'ট্রানজেকশন');
    XLSX.writeFile(wb, `বিদ্যুৎ_বিল_রিপোর্ট_${new Date().toISOString().split('T')[0]}.xlsx`);
    showToast('✅ এক্সেল ফাইল ডাউনলোড হয়েছে', 'success');
}

function printReport() {
    window.print();
}
